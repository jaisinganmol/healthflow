# =============================================================================
# HealthFlow AI - Root .gitignore
# =============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Static Analysis
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Sensitive Credentials, Private Keys & Environment Variables (HIPAA Security)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12

# Local Data Storage & Audit Logs
data/*.jsonl
!data/.gitkeep

# Terraform Infrastructure
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Frontend / Next.js / Node
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.vercel
frontend/.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# OS & IDE Cache
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
